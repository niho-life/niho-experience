    "./contract/experience-translate-rooms-api.openapi.json": "./contract/experience-translate-rooms-api.openapi.json"
  },
  "scripts": {
    "gen:types": "node ./scripts/gen-types.ts",
    "check:types": "node ./scripts/gen-types.ts --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "verify:live": "node ./scripts/verify-live.ts",
    "check": "npm run check:types && npm run typecheck && npm run test"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
