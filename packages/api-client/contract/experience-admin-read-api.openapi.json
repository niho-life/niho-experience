{
  "openapi": "3.0.3",
  "info": {
    "title": "NIHO Experience Admin Read API",
    "version": "1.0.0",
    "description": "niho-experienceのAdmin画面へ配る予約一覧・詳細・通知の選別契約。正本はniho-appのcontracts/openapi.yaml。app-connect認証接続は別契約で、現在未配備。",
    "x-niho-contract-status": "agreed-not-deployed",
    "x-niho-contract-source": "niho-app contracts/openapi.yaml",
    "x-niho-contract-sha256-file": "experience-admin-read-api.openapi.json.sha256"
  },
  "servers": [
    {
      "url": "https://niho.life",
      "description": "NIHO API origin"
    }
  ],
  "security": [
    {
      "FirebaseIdToken": []
    }
  ],
  "tags": [
    {
      "name": "Admin"
    }
  ],
  "paths": {
    "/api/admin/experience-bookings": {
      "get": {
        "tags": [
          "Admin"
        ],
        "operationId": "listAdminExperienceBookings",
        "summary": "platform ADMINが体験予約を横断して読む",
        "description": "提供者器の体験予約と通常拠点のEXPERIENCE_SITE体験予約だけを返す。platform ADMIN専用。\n全応答は `Cache-Control: private, no-store`。AppConnectの接続・scopeは認証専用契約で後続接続する。\n",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "hostId",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "hostSearch",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ExperienceAdminBookingStatus"
            }
          },
          {
            "name": "support",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "on",
                "off",
                "legacy"
              ]
            }
          },
          {
            "name": "attention",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ExperienceAdminPrivateNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminBookingListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ExperienceAdminValidationError"
          },
          "401": {
            "$ref": "#/components/responses/ExperienceAdminUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ExperienceAdminForbidden"
          }
        }
      }
    },
    "/api/admin/experience-bookings/query": {
      "post": {
        "tags": [
          "Admin"
        ],
        "operationId": "queryAdminExperienceBookings",
        "summary": "platform ADMINがJSON本文で体験予約を検索する",
        "description": "予約者名・ホスト名などの検索語をrequest URLへ載せない読取経路。\n公開Admin画面の検索にはこの経路を使う。GETと同じ対象・cursor・応答で、予約は変更しない。\n全応答は `Cache-Control: private, no-store`。\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExperienceAdminBookingQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ExperienceAdminPrivateNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminBookingListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ExperienceAdminValidationError"
          },
          "401": {
            "$ref": "#/components/responses/ExperienceAdminUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ExperienceAdminForbidden"
          }
        }
      }
    },
    "/api/admin/experience-bookings/{requestId}": {
      "get": {
        "tags": [
          "Admin"
        ],
        "operationId": "getAdminExperienceBooking",
        "summary": "platform ADMINが体験予約詳細を読む",
        "description": "platform ADMIN専用。Stripe内部IDを返さない。全応答は\n`Cache-Control: private, no-store`。\n",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ExperienceAdminPrivateNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminBookingDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ExperienceAdminUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ExperienceAdminForbidden"
          },
          "404": {
            "$ref": "#/components/responses/ExperienceAdminNotFound"
          }
        }
      }
    },
    "/api/admin/experience-support-notifications": {
      "get": {
        "tags": [
          "Admin"
        ],
        "operationId": "listAdminExperienceSupportNotifications",
        "summary": "platform ADMINが支援対象予約の通知を読む",
        "description": "支援ONの予約に属する管理画面内通知。既読はAdmin本人ごとで、全対象の未読件数を返す。\n新しい連絡は旅行者からの受信保存経路が未整備のため、この版では生成しない。全応答は `Cache-Control: private, no-store`。\n",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "unread",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ExperienceAdminPrivateNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminNotificationListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ExperienceAdminValidationError"
          },
          "401": {
            "$ref": "#/components/responses/ExperienceAdminUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ExperienceAdminForbidden"
          },
          "405": {
            "$ref": "#/components/responses/ExperienceAdminMethodNotAllowed"
          }
        }
      }
    },
    "/api/admin/experience-support-notifications/read": {
      "post": {
        "tags": [
          "Admin"
        ],
        "operationId": "markAdminExperienceSupportNotificationsRead",
        "summary": "platform ADMIN本人の通知を既読にする",
        "description": "1〜64件を本人の既読にする。未知・対象外IDを1件でも含めれば全件拒否し、再送は最初のreadAtを維持する。\n成功時は同じtransactionで既読反映後の全対象未読件数も返す。予約のneedsAttentionや業務状態は変更しない。\n全応答は `Cache-Control: private, no-store`。\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExperienceAdminNotificationReadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ExperienceAdminPrivateNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminNotificationReadResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ExperienceAdminValidationError"
          },
          "401": {
            "$ref": "#/components/responses/ExperienceAdminUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ExperienceAdminForbidden"
          },
          "404": {
            "$ref": "#/components/responses/ExperienceAdminNotFound"
          },
          "405": {
            "$ref": "#/components/responses/ExperienceAdminMethodNotAllowed"
          }
        }
      }
    }
  },
