                }
              }
            }
          },
          "202": {
            "description": "Accepted or result unknown",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ExperienceAdminPrivateNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationError"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationError"
                }
              }
            }
          }
        }
      }
    },
