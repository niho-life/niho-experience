  "components": {
    "schemas": {
      "ExperienceAdminApproveRequest": {
        "x-niho-experience-admin-operation-dto": true,
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "expectedRevision",
          "expectedStatus",
          "expectedTotalYen",
          "expectedRefundedYen",
          "reasonCode"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "expectedStatus": {
            "type": "string",
            "enum": [
              "PROVISIONAL"
            ]
          },
          "expectedTotalYen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "expectedRefundedYen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "HOST_CONFIRMED",
              "SUPPORT_REVIEWED"
            ]
          }
        }
      },
      "ExperienceAdminCancelRequest": {
        "x-niho-experience-admin-operation-dto": true,
        "type": "object",
