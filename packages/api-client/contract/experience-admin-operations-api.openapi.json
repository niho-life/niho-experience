        "required": [
          "operationId",
          "expectedRevision",
          "expectedStatus",
          "expectedTotalYen",
          "expectedRefundedYen",
          "expectedProviderRefundedYen",
          "expectedRefundAmountYen",
          "refund",
          "reasonCode",
          "message"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "expectedStatus": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "REFUND_NEEDED"
            ]
          },
          "expectedTotalYen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "expectedRefundedYen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "expectedProviderRefundedYen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "expectedRefundAmountYen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "refund": {
            "type": "string",
            "enum": [
              "FULL",
              "HALF",
              "NONE"
            ]
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "HOST_CANNOT_HOST",
              "GUEST_REQUEST",
              "OTHER"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "ExperienceAdminDeclineRequest": {
        "x-niho-experience-admin-operation-dto": true,
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "expectedRevision",
          "expectedStatus",
          "expectedTotalYen",
          "expectedRefundedYen",
          "reasonCode"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
