      "ExperienceAdminSupportOperationBookingSnapshot": {
        "x-niho-experience-admin-operation-dto": true,
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bookingRequestId",
          "revision",
          "updatedAt",
          "host",
          "guest",
          "status",
