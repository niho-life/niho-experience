{
  "openapi": "3.0.3",
  "info": {
    "title": "NIHO Experience Admin Operations API",
    "version": "1.0.0",
    "description": "支援ONの体験予約に対するNIHO事務局操作の選別契約。APIを先に配備・受入し、clientはSHA固定後に採番する。",
    "x-niho-contract-status": "agreed-not-deployed",
    "x-niho-contract-source": "niho-app contracts/openapi.yaml",
    "x-niho-contract-sha256-file": "experience-admin-operations-api.openapi.json.sha256"
  },
  "servers": [
    {
      "url": "https://niho.life",
      "description": "NIHO API origin"
    }
  ],
  "security": [
    {
      "FirebaseIdToken": []
    }
  ],
  "tags": [
    {
      "name": "Admin"
    }
  ],
  "paths": {
    "/api/admin/experience-bookings/{requestId}/support-operations": {
      "get": {
        "tags": [
          "Admin"
        ],
        "operationId": "getAdminExperienceSupportOperations",
        "summary": "platform ADMINが予約の最新操作snapshotと支援操作履歴を読む",
        "description": "支援操作専用のCAS revision、現在状態、元の金額、DB/Stripe返金観測、可能操作と直近50件の履歴を返す。\nStripe ID・payload hash・内部メモは返さない。履歴上限とtruncatedを明示し、GETでは決済・返金・送信を開始しない。\n",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ExperienceAdminPrivateNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationSnapshotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationError"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/experience-bookings/{requestId}/support-operations/{operationId}": {
      "get": {
        "tags": [
          "Admin"
        ],
        "operationId": "getAdminExperienceSupportOperation",
        "summary": "platform ADMINが既知のoperation IDで保存済み結果を照合する",
        "description": "予約IDとoperation IDの両方を照合する。未発見を未実行・確実な失敗とは断定しない。",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "operationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ExperienceAdminPrivateNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceAdminSupportOperationError"
                }
              }
            }
          }
        }
      }
    },
