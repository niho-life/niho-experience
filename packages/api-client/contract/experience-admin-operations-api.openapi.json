            "format": "date-time"
          }
        }
      },
      "ExperienceAdminSupportOperation": {
        "x-niho-experience-admin-operation-dto": true,
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "bookingRequestId",
          "action",
          "actorKind",
          "reasonCode",
          "expectedRevision",
          "expectedStatus",
          "expectedTotalYen",
          "expectedRefundedYen",
          "expectedProviderRefundedYen",
          "requestedRefundAmountYen",
          "state",
          "resultCode",
          "resultStatus",
          "resultRefundedYen",
          "retryAllowed",
          "message",
          "firstExternalAttemptAt",
          "lastReconciledAt",
          "completedAt",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "bookingRequestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "action": {
            "type": "string",
            "enum": [
              "APPROVE",
              "DECLINE",
              "CANCEL",
              "MESSAGE"
            ]
          },
          "actorKind": {
            "type": "string",
            "enum": [
              "NIHO_SUPPORT"
            ]
          },
          "reasonCode": {
            "type": "string",
            "nullable": true
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "expectedStatus": {
            "type": "string"
          },
          "expectedTotalYen": {
            "type": "integer",
            "minimum": 0
          },
          "expectedRefundedYen": {
            "type": "integer",
            "minimum": 0
          },
          "expectedProviderRefundedYen": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "requestedRefundAmountYen": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "state": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "PROCESSING",
              "UNKNOWN",
              "SUCCEEDED",
              "REJECTED",
              "FAILED"
            ]
          },
          "retryAllowed": {
            "type": "boolean",
            "description": "同じIDとpayloadを保持するクライアントだけが再送できる。write停止・SMTP曖昧結果・24時間到達後はfalse。"
          },
          "resultCode": {
            "type": "string",
            "nullable": true
          },
          "resultStatus": {
            "type": "string",
            "nullable": true
          },
          "resultRefundedYen": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "message": {
            "$ref": "#/components/schemas/ExperienceAdminSupportOperationMessage"
          },
          "firstExternalAttemptAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastReconciledAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
