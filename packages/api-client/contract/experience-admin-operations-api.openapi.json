          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "ExperienceAdminProviderRefundObservation": {
        "x-niho-experience-admin-operation-dto": true,
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "refundedYen",
          "observedAt"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "KNOWN",
