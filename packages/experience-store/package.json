{
  "name": "@niho-experience/experience-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL persistence for NIHO Experience schedules, availability, bookings, and payment ledger.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@niho-experience/experience-domain": "0.1.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
