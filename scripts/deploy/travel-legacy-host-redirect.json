{
  "ref": "travel_legacy_host_redirect",
  "description": "Permanently redirect every URL on the former NIHO Travel host",
  "expression": "http.host eq \"experience.niho.life\"",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://travel.niho.life\", raw.http.request.uri.path)"
      },
      "status_code": 301,
      "preserve_query_string": true
    }
  },
  "enabled": true
}
