{
  "name": "@niho-experience/web",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "sh scripts/start-standalone.sh",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p e2e",
    "typecheck:presentation": "tsc --noEmit -p tsconfig.presentation.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:host-calendar": "playwright test --config playwright.host-calendar.config.ts",
    "test:e2e:assisted-launch": "playwright test --config playwright.assisted-launch.config.ts --workers=1",
    "test:e2e:provider-operations": "playwright test --config playwright.provider-operations.config.ts --workers=1",
    "test:e2e:documents": "playwright test --config playwright.documents.config.ts",
    "test:e2e:guide-editor": "playwright test --config playwright.guide-editor.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/nunito": "^5.2.7",
    "@google-cloud/storage": "7.22.0",
    "google-auth-library": "9.15.1",
    "@niho-experience/api-client": "*",
    "@niho-experience/experience-domain": "*",
    "@niho-experience/experience-payments": "*",
    "@niho-experience/experience-store": "*",
    "@niho-experience/google-calendar": "*",
    "@niho-experience/web-push": "*",
    "@niho/experience-presentation": "*",
    "@niho/web": "git+https://github.com/niho-coliving/niho-web.git#ac98e3068a5c13d817c390ff164fb37eab42f6ee",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "next": "16.3.8",
    "nodemailer": "10.1.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.18.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.56.1",
    "tailwindcss": "^4.1.18",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
