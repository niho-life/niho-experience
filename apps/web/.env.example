# Copy to .env.local only if you need to change a default. No secrets belong here.

# "mock" (default) uses synthetic fixtures. "http" calls the NIHO public API.
EXPERIENCE_API_MODE=mock
# Keep at 1.0 until NIHO has deployed and verified its v1.1 public API.
EXPERIENCE_PUBLIC_API_VERSION=1.0
# #59/#66 acceptance gates. Keep false until the exact pinned presentation source
# and one approved Japanese release have both been deployed and accepted.
EXPERIENCE_JAPANESE_SITE_ENABLED=false
# Public NIHO web origin, used by the browser for availability and checkout.
NEXT_PUBLIC_NIHO_WEB_ORIGIN=https://niho.life

# Artificial latency for the mock, in ms, to review loading states.
MOCK_LATENCY_MS=0

# Mock catalog: "synthetic" (default, invented sample data) or "pilot" (the first
# experiences whose hosts agreed to be listed, with provisional prices and dates).
MOCK_CATALOG=synthetic

# Mock only: absolute path of a folder of guide drafts ({slug}.md, kept outside git)
# shown on /guides marked "Draft" (docs/content/guides.md). Ignored in http mode.
# GUIDE_DRAFTS_DIR=/absolute/path/niho-experience-secret/guides

# Public guide source (#189): keep static until the CMS migration/bucket/auth
# staging gates in docs/guide-cms.md pass. "database" is HTTP-only and requires
# both server-side settings below; never put real values in this example file.
EXPERIENCE_GUIDE_PUBLIC_SOURCE=static
# EXPERIENCE_DATABASE_URL=
# GUIDE_MEDIA_BUCKET=

# NIHO platform ADMIN server -> Experience guide grants/categories (#224).
# HTTP-only and default OFF. Authentication is a freshly minted Google service
# account ID token for the exact audience and service-account email below.
# Use the Cloud Run service URL or a configured custom audience (not a custom
# domain by itself). EXPERIENCE_DATABASE_URL
# above is also required. Never expose these settings through NEXT_PUBLIC_*.
GUIDE_ADMIN_API_ENABLED=false
# GUIDE_ADMIN_AUDIENCE=https://YOUR_CLOUD_RUN_SERVICE_URL
# GUIDE_ADMIN_SERVICE_ACCOUNT_EMAIL=guide-admin@example.iam.gserviceaccount.com

# Canonical origin used for metadata and the sitemap. The production domain is
# not decided yet.
SITE_URL=http://localhost:3000

# Search engines are blocked unless this is exactly "allow" AND the API mode is
# "http" (production only, after acceptance in #15). Sample data is never indexed.
SITE_INDEXING=block

# Provider entry (#11). Keep "pilot" until NIHO integration B is deployed and
# the provider signup path is accepted. "open" shows the self-service route.
HOST_SIGNUP_MODE=pilot
# Exact NIHO provider route: manage existing experiences in pilot; start registration in open.
# NIHO_HOST_START_URL=https://niho.life/experiences/provider
# HOST_PILOT_CONTACT_URL=

# Incident switch (#15): "false" stops new bookings on the site without a code change.
BOOKINGS_ENABLED=true

# Where guests check a booking on NIHO after payment (integration A).
# NIHO_BOOKING_HELP_URL=

# Host console at /host/home (#86): sign in with a NIHO account. Off unless "true".
# In mock mode it uses synthetic sessions (/host/auth/mock-login) and a fixed
# development key; in http mode both values below are required or the server
# refuses to start. Real values come from Secret Manager, never from this file.
HOST_CONSOLE_ENABLED=false
# The console as an installable app (#177, docs/host-pwa.md): manifest, /host/sw.js and 設定's この端末.
# Needs HOST_CONSOLE_ENABLED=true. Setting it back to false serves a worker that removes itself.
HOST_PWA_ENABLED=false
# Web Push to that app (#177 P2). Needs HOST_PWA_ENABLED=true; mock mode uses a development
# public key and never sends. In http mode all three VAPID values are required (the private key
# from Secret Manager only, never from this file). Not wired to the notification job yet.
HOST_PUSH_ENABLED=false
# HOST_PUSH_VAPID_PUBLIC_KEY=
# HOST_PUSH_VAPID_SUBJECT=mailto:
# HOST_PUSH_VAPID_PRIVATE_KEY=
# Provider team + booking operations v1.1.0. HTTP only and independent of Admin/assisted-launch.
# Keep false until niho-app auth PRs #19282/#19353 and API PR #19405 are deployed and accepted;
# niho-experience consumer PR #170 then enables it per environment.
EXPERIENCE_PROVIDER_OPERATIONS_API_ENABLED=false
# Mock-only UI acceptance with contract-shaped synthetic browser stubs. Never opens the real transport.
EXPERIENCE_PROVIDER_OPERATIONS_PREVIEW_ENABLED=false
# Per-resource Google busy input (#238). Both switches are default OFF; mock and
# preview acceptance uses browser stubs and never opens OAuth, DB, or Studio sync.
EXPERIENCE_RESOURCE_GOOGLE_ENABLED=false
EXPERIENCE_RESOURCE_GOOGLE_WATCH_ENABLED=false
# Airbnb availability control through a dedicated app-created Google output
# calendar (#270). HTTP channel runtime only; default OFF until calendar
# provisioning, Google consent, Airbnb connection, observer and soak acceptance.
EXPERIENCE_AIRBNB_GOOGLE_DELIVERY_ENABLED=false
# OWNER-only backend for creating one inactive Airbnb output binding. HTTP only;
# keep OFF until UI, initial anchor, Airbnb connection and observer acceptance exist.
EXPERIENCE_AIRBNB_GOOGLE_SETUP_ENABLED=false
# OTA runtime watchdog (POST /internal/ota/v1/watchdog). HTTP only, default OFF.
# Cloud Scheduler calls it with an OIDC ID token; both values below are required,
# and a worker bearer or Admin cookie is never accepted (docs/ota-runtime.md).
EXPERIENCE_CHANNEL_WATCHDOG_ENABLED=false
# EXPERIENCE_CHANNEL_WATCHDOG_AUDIENCE=https://YOUR_SERVICE_BASE_URL
# EXPERIENCE_CHANNEL_WATCHDOG_SERVICE_ACCOUNT_EMAIL=experience-ota-watchdog@YOUR_PROJECT.iam.gserviceaccount.com
# Required only when watch is enabled in production. Use the deployed public HTTPS
# endpoint ending in /api/google/calendar/watch; never use a preview or localhost URL.
# EXPERIENCE_RESOURCE_GOOGLE_WEBHOOK_URL=https://experience.example/api/google/calendar/watch
# 対面通訳 (#181): the host screen's 通訳を始める BFF (/host/api/translate). HTTP only; the mock serves
# synthetic rooms without a flag. Keep false until niho-app N1b (#19447) is deployed and accepted.
EXPERIENCE_TRANSLATE_API_ENABLED=false
# 設定 › 通知 (#109): the three notifications the OWNER may stop, kept in the experience DB (migration
# 0020). HTTP only; the mock keeps the switches on screen. Keep false until accepted per environment.
HOST_NOTIFICATION_SETTINGS_ENABLED=false
# 予約前の質問 (#105/#106, docs/guest-questions.md): "Ask the host", the guest's reply page and メッセージ's
# questions, kept in the experience DB (migration 0022; needs EXPERIENCE_DATABASE_URL). HTTP only, with
# HOST_CONSOLE_ENABLED=true and EXPERIENCE_PROVIDER_OPERATIONS_API_ENABLED off (the OWNER must be able to read
# them); the mock keeps its synthetic questions. Keep false until accepted per environment.
EXPERIENCE_GUEST_QUESTIONS_ENABLED=false
# Key(s) for the encrypted host cookies, at least 32 characters each. Comma-separated
# while rotating: the first seals new cookies, the others still open old ones.
# HOST_SESSION_SECRET=
# Firebase Web API key of the NIHO project, to turn NIHO's custom token into an ID token.
# NIHO_FIREBASE_WEB_API_KEY=

# Admin reservation-support preview (#118/#119). Default OFF. In mock mode only,
# this enables the synthetic /admin sign-in and data. In http mode it enables the
# real Admin auth boundary. Read transport has a separate default-OFF rollout flag.
ADMIN_SUPPORT_CONSOLE_ENABLED=false
# Enable only after NIHO deploys and accepts the pinned Admin read v1.0.0 contract.
ADMIN_SUPPORT_READ_API_ENABLED=false
# Local/Playwright UI preview only. Mock mode renders the typed read UI while its
# real BFF remains closed; tests supply contract-shaped synthetic browser stubs.
ADMIN_SUPPORT_READ_PREVIEW_ENABLED=false
# Enable only after NIHO deploys and accepts the pinned support-case v1.0.0 contract.
ADMIN_SUPPORT_CASE_API_ENABLED=false
# Mock-only browser-stub UI acceptance. Ignored in HTTP mode; the BFF remains closed.
ADMIN_SUPPORT_CASE_PREVIEW_ENABLED=false
# Agreed-not-deployed immutable booking operations. Keep OFF until API deployment and acceptance.
ADMIN_OPERATIONS_API_ENABLED=false
# Synthetic browser-stub UI acceptance only; ignored in HTTP mode.
ADMIN_OPERATIONS_PREVIEW_ENABLED=false
# Agreed-not-deployed host-owned support history. Keep OFF until API deployment and acceptance.
HOST_SUPPORT_HISTORY_API_ENABLED=false
# Host OWNER support settings v1.0.0. HTTP only; keep OFF until NIHO deploys and acceptance passes.
HOST_SUPPORT_SETTINGS_API_ENABLED=false
# Synthetic browser-stub UI acceptance only. Ignored in HTTP mode; it never opens the BFF.
HOST_SUPPORT_SETTINGS_PREVIEW_ENABLED=false
# Real Admin auth has a dedicated cookie key. At least 32 characters; comma-separated
# while rotating. Required only when Admin is enabled in http mode.
# ADMIN_SESSION_SECRET=
# Exact public origin registered in NIHO's APP_CONNECT_EXPERIENCE_ADMIN_ORIGIN.
# HTTPS is required except loopback HTTP for local development. It must equal SITE_URL's origin.
# NIHO_EXPERIENCE_ADMIN_ORIGIN=http://localhost:3000

# Guide editor browser connect (#191). No mock bypass exists. Keep OFF until
# NIHO's dedicated connection API is deployed and end-to-end acceptance passes.
# Enabling also requires NIHO_FIREBASE_WEB_API_KEY above.
EDITOR_CONSOLE_ENABLED=false
# Dedicated encrypted /editor cookie key(s), at least 32 characters each.
# Comma-separated while rotating; never reuse HOST_SESSION_SECRET or ADMIN_SESSION_SECRET.
# EDITOR_SESSION_SECRET=
# Origin of the fixed callback registered as NIHO's EXPERIENCE_EDITOR_CALLBACK_URL
# (this origin plus /editor/auth/callback). It must equal SITE_URL's origin.
# NIHO_EXPERIENCE_EDITOR_ORIGIN=https://localhost:3000
